import tkinter as tk
from tkinter import messagebox

def calculate_keys():
    try:
        p = int(p_entry.get())
        g = int(g_entry.get())
        a = int(Riddhi_entry.get())
        b = int(Tanu_entry.get())

        A = pow(g, a, p)
        B = pow(g, b, p)

        key_Riddhi = pow(B, a, p)
        key_Tanu = pow(A, b, p)

        Riddhi_public_label.config(
            text="Riddhi's Public Key: " + str(A)
        )

        Tanu_public_label.config(
            text="Tanu's Public Key: " + str(B)
        )

        Riddhi_shared_label.config(
            text="Riddhi's Shared Secret Key: " + str(key_Riddhi)
        )

        Tanu_shared_label.config(
            text="Tanu's Shared Secret Key: " + str(key_Tanu)
        )

        if key_Riddhi == key_Tanu:
            result_label.config(
                text="Key Exchange Successful!\n"
                     "Both Riddhi and Tanu have the same secret key.",
                fg="green"
            )
        else:
            result_label.config(
                text="Key Exchange Failed!",
                fg="red"
            )

    except ValueError:
        messagebox.showerror(
            "Error",
            "Please enter valid numbers."
        )

def clear_all():
    p_entry.delete(0, tk.END)
    g_entry.delete(0, tk.END)
    Riddhi_entry.delete(0, tk.END)
    Tanu_entry.delete(0, tk.END)

    Riddhi_public_label.config(text="")
    Tanu_public_label.config(text="")
    Riddhi_shared_label.config(text="")
    Tanu_shared_label.config(text="")
    result_label.config(text="")

root = tk.Tk()
root.title("Diffie-Hellman Key Exchange")
root.geometry("650x650")
root.resizable(False, False)

title = tk.Label(
    root,
    text="DIFFIE-HELLMAN KEY EXCHANGE",
    font=("Arial", 20, "bold")
)
title.pack(pady=20)

tk.Label(
    root,
    text="Enter Prime Number (p):",
    font=("Arial", 12, "bold")
).pack()

p_entry = tk.Entry(
    root,
    width=30,
    font=("Arial", 12)
)
p_entry.pack(pady=5)

tk.Label(
    root,
    text="Enter Primitive Root (g):",
    font=("Arial", 12, "bold")
).pack()

g_entry = tk.Entry(
    root,
    width=30,
    font=("Arial", 12)
)
g_entry.pack(pady=5)

tk.Label(
    root,
    text="Enter Riddhi's Private Key:",
    font=("Arial", 12, "bold")
).pack()

Riddhi_entry = tk.Entry(
    root,
    width=30,
    font=("Arial", 12)
)
Riddhi_entry.pack(pady=5)

tk.Label(
    root,
    text="Enter Tanu's Private Key:",
    font=("Arial", 12, "bold")
).pack()

Tanu_entry = tk.Entry(
    root,
    width=30,
    font=("Arial", 12)
)
Tanu_entry.pack(pady=5)

tk.Button(
    root,
    text="Generate Shared Key",
    command=calculate_keys,
    font=("Arial", 11, "bold"),
    padx=20,
    pady=7
).pack(pady=15)

Riddhi_public_label = tk.Label(
    root,
    text="",
    font=("Arial", 11, "bold")
)
Riddhi_public_label.pack(pady=5)

Tanu_public_label = tk.Label(
    root,
    text="",
    font=("Arial", 11, "bold")
)
Tanu_public_label.pack(pady=5)

Riddhi_shared_label = tk.Label(
    root,
    text="",
    font=("Arial", 11, "bold")
)
Riddhi_shared_label.pack(pady=5)

Tanu_shared_label = tk.Label(
    root,
    text="",
    font=("Arial", 11, "bold")
)
Tanu_shared_label.pack(pady=5)

result_label = tk.Label(
    root,
    text="",
    font=("Arial", 11, "bold"),
    justify="center"
)
result_label.pack(pady=20)

tk.Button(
    root,
    text="Clear",
    command=clear_all,
    font=("Arial", 10),
    padx=25
).pack()

root.mainloop()
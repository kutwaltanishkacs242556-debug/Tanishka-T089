import hmac
import hashlib

# Secret key shared between sender and receiver
secret_key = b"mysecretkey"

# Message
message = input("Enter the message: ").encode()

# Generate MAC
mac = hmac.new(secret_key, message, hashlib.sha256).hexdigest()

print("\nGenerated MAC:", mac)

# Verification
received_message = input("\nEnter received message: ").encode()
received_mac = input("Enter received MAC: ")

# Generate MAC for received message
new_mac = hmac.new(secret_key, received_message, hashlib.sha256).hexdigest()

# Verify
if hmac.compare_digest(received_mac, new_mac):
    print("\nMAC Verification Successful.")
    print("Message is Authentic and Integrity is Preserved.")
else:
    print("\nMAC Verification Failed.")
    print("Message has been Altered or Key is Incorrect.")